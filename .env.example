# VisionInspect AI Environment Configuration

# Backend API Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://localhost:5173

# Database Configuration
DATABASE_URL=sqlite:///./database/visioninspect.db

# Storage Directories
